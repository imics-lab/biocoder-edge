# BioCoder-Edge Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in your actual values
# The .env file is git-ignored to protect your sensitive information
# 
# Usage: cp env.example .env
# -----------------------------------------------------------------------------

# =============================================================================
# Hardware Configuration
# =============================================================================
# Video source - camera index (0, 1, 2...) or path to video file
VIDEO_SOURCE=0

# Camera resolution and framerate
# Run 'v4l2-ctl -d /dev/videoX --list-formats-ext' to see supported values
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30

# =============================================================================
# Device Information
# =============================================================================
DEVICE_ID=my_camera_001
DEVICE_LATITUDE=37.7749
DEVICE_LONGITUDE=-122.4194

# =============================================================================
# Data Uploader Configuration
# =============================================================================
# Enable or disable data uploader (true/false)
# Set to false for testing/development to keep files local
UPLOADER_ENABLED=false

# =============================================================================
# SFTP Configuration (for file uploads)
# =============================================================================
SFTP_HOST=your.server.hostname.com
SFTP_PORT=22
SFTP_USERNAME=your_username
SFTP_SSH_KEY_PATH=/home/biocoder/.ssh/your_private_key
SFTP_REMOTE_VIDEO_DIR=/path/to/remote/videos
SFTP_REMOTE_JSON_DIR=/path/to/remote/metadata

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
DB_HOST=your.database.host.com
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_db_username
DB_PASSWORD=your_secure_password
